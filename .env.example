# Server-only. Never prefix these with NEXT_PUBLIC_.
# Copy this file to .env.local for `next dev` and for the Vercel project settings.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Absolute origin of the deployed Next app.
# The Android WebView calls this origin so the APK never contains provider keys.
NEXT_PUBLIC_AI_PROXY_URL=https://fitbite-pro.vercel.app
